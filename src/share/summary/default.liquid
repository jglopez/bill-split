{%- comment -%}
  The plain-text summary people paste into a group chat: each person's
  share, then how the bill adds up. It only formats: every amount comes
  from the template data. See templateData.ts for the fields, and
  renderSummary.ts for the filters available.

  `bold` makes text bold in the rich-text copy and leaves plain text alone.
{%- endcomment -%}
{% if name != "" %}{{ name | bold }}{% else %}{{ "Bill split" | bold }}{% endif %}
{% for person in people %}
{{ person.name }}: {{ person.total | money }}
{%- endfor %}

Subtotal: {{ totals.subtotal | money }}
{%- if totals.tax != 0 %}
Tax: {{ totals.tax | money }}
{%- endif %}
{%- if totals.tip != 0 %}
Tip: {{ totals.tip | money }}
{%- endif %}
{%- for fee in totals.fees %}
{{ fee.name }}: {{ fee.amount | money }}
{%- endfor %}
{% capture total %}Total: {{ totals.grandTotal | money }}{% endcapture %}{{ total | bold }}
